NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=3000
DATABASE_URL=postgresql://nexadesk:nexadesk_local_only@localhost:5433/nexadesk
POSTGRES_PORT=5433
FRONTEND_ORIGIN=http://localhost:5173

# Set a random local-only value in .env. Never enable in production.
DEV_AUTH_ENABLED=true
DEV_AUTH_TOKEN=
DEV_TENANT_ID=00000000-0000-4000-8000-000000000001
DEV_USER_ID=00000000-0000-4000-8000-000000000002

# Frontend API mode. Set VITE_APP_MODE=demo only for isolated local mock data.
VITE_APP_MODE=api
VITE_API_BASE_URL=
VITE_TENANT_ID=

# Auth0 issuer and JWKS URL are public metadata; set AUTH_AUDIENCE to the
# identifier of a custom API created for NexaDesk, never the Management API.
AUTH_ISSUER=https://dev-p6kqizl6ky1vw0am.us.auth0.com/
AUTH_AUDIENCE=https://nexadesk-api
AUTH_JWKS_URL=https://dev-p6kqizl6ky1vw0am.us.auth0.com/.well-known/jwks.json

# Agent runtime defaults to disabled. "fake" is local-only; "openai" makes
# paid server-side calls only when explicitly enabled for a tenant and invoked.
AGENT_PROVIDER=disabled
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Telegram is disabled by default. Configure both values and explicitly switch
# CHANNEL_ADAPTER to telegram only after creating a bot and webhook endpoint.
CHANNEL_ADAPTER=test
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# Auth0 SPA settings; all VITE_* values are public and must contain no secrets.
VITE_AUTH0_DOMAIN=dev-p6kqizl6ky1vw0am.us.auth0.com
VITE_AUTH0_CLIENT_ID=
VITE_AUTH0_AUDIENCE=https://nexadesk-api
VITE_AUTH0_REDIRECT_URI=http://127.0.0.1:5173
